# App
APP_ENV=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Public URLs
# In Docker, the Streamlit container calls FastAPI through http://api:8000.
# For browser-facing CORS, add your deployed frontend/API origins here.
PUBLIC_API_URL=http://api:8000
CORS_EXTRA_ORIGINS=https://your-ui-domain.example,https://your-api-domain.example
API_PORT=8000
STREAMLIT_PORT=8501

# LLM (Groq primary, OpenAI fallback)
GROQ_API_KEY=
OPENAI_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# Search
SERPAPI_KEY=

# Postgres
POSTGRES_USER=rozgaar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rozgaar
DATABASE_URL=postgresql+asyncpg://rozgaar:change-me@postgres:5432/rozgaar

# Redis
REDIS_URL=redis://redis:6379/0

# ChromaDB
CHROMA_URL=http://chroma:8000

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=raw-html

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Auth (generate a fresh RS256 keypair for production)
# Example:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
# Then paste the PEM values into these variables, preserving line breaks if your deploy platform supports them.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_PASSWORD_SECRET=change-me
VERIFICATION_SECRET=change-me
