################################################################################
#                   ROZGAAR AI ENVIRONMENT CONFIGURATION
#
# This file documents ALL environment variables required and optional for the
# application to run. Copy this to .env and fill in the required values.
#
# Required variables (marked with **REQUIRED**):
#   - Application will fail to start if these are missing or empty
#   - No defaults are provided for security reasons
#
# Optional variables (marked with DEFAULT):
#   - Each has a sensible default suitable for local development
#   - Override in production only if needed
#
################################################################################

# ==================== REQUIRED: DATABASE ====================
# Connection string for PostgreSQL with asyncpg driver.
# Format: postgresql+asyncpg://user:password@host:port/database
# **REQUIRED**
DATABASE_URL=postgresql+asyncpg://rozgaar:change-me@postgres:5432/rozgaar

# ==================== REQUIRED: CACHE ====================
# Redis connection string for caching and Celery broker.
# Format: redis://host:port/database
# **REQUIRED**
REDIS_URL=redis://redis:6379/0

# ==================== REQUIRED: SECURITY ====================
# JWT signing secret for authentication tokens.
# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
# **REQUIRED** — Minimum 32 characters for production
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long

# ==================== REQUIRED: LLM ====================
# Groq API key for LLM calls (resume and email generation).
# Get from https://console.groq.com/keys
# **REQUIRED**
GROQ_API_KEY=

# ==================== OPTIONAL: API CONFIGURATION ====================
# API v1 endpoint prefix.
# DEFAULT: /api/v1
API_V1_PREFIX=/api/v1

# ==================== OPTIONAL: SEMANTIC SEARCH & VECTOR DB ====================
# ChromaDB HTTP endpoint for semantic search and vector embeddings.
# For local dev with Docker Compose, use: http://chromadb:8000
# DEFAULT: http://chromadb:8000
CHROMA_HOST=http://chromadb:8000

# ==================== OPTIONAL: BACKGROUND JOBS & QUEUES ====================
# Redis connection string for Celery broker (task queue).
# Format: redis://host:port/database
# DEFAULT: redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1

# Redis connection string for Celery result backend (task results storage).
# Format: redis://host:port/database
# DEFAULT: redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==================== OPTIONAL: AUTHENTICATION & TOKENS ====================
# JWT private key for signing tokens (RS256).
# Can also read from JWT_PRIVATE_KEY_FILE instead (recommended for Docker).
# If using environment variable, escape newlines as \n.
# DEFAULT: (empty, reads from JWT_PRIVATE_KEY_FILE if set)
JWT_PRIVATE_KEY=

# JWT public key for verifying tokens (RS256).
# Can also read from JWT_PUBLIC_KEY_FILE instead (recommended for Docker).
# If using environment variable, escape newlines as \n.
# DEFAULT: (empty, reads from JWT_PUBLIC_KEY_FILE if set)
JWT_PUBLIC_KEY=

# Path to file containing JWT private key (Docker Compose recommended).
# DEFAULT: (empty)
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key

# Path to file containing JWT public key (Docker Compose recommended).
# DEFAULT: (empty)
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key

# JWT access token expiration time in minutes.
# DEFAULT: 60
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Secret for password reset token generation.
# DEFAULT: reset-password-secret
RESET_PASSWORD_SECRET=reset-password-secret

# Secret for email verification token generation.
# DEFAULT: verification-secret
VERIFICATION_SECRET=verification-secret

# ==================== OPTIONAL: S3-COMPATIBLE STORAGE ====================
# All S3 settings use boto3, so they work with any S3-compatible endpoint.
#
# For LOCAL DEVELOPMENT (MinIO):
#   S3_ENDPOINT_URL=http://minio:9000
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin
#
# For PRODUCTION (Cloudflare R2):
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=<your-r2-access-key-id>
#   S3_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
#
#   To get R2 credentials:
#   1. Log in to Cloudflare Dashboard
#   2. Go to R2 → API Tokens
#   3. Create API Token with read/write access to your bucket
#   4. Use the generated Access Key ID and Secret Access Key below
#
# DEFAULT: http://minio:9000 (local MinIO)
S3_ENDPOINT_URL=http://minio:9000

# S3 access key ID (for MinIO: minioadmin, for R2: generated token)
# DEFAULT: minioadmin
S3_ACCESS_KEY_ID=minioadmin

# S3 secret access key (for MinIO: minioadmin, for R2: generated token)
# DEFAULT: minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# S3 bucket name for storing customized resumes and generated PDFs.
# DEFAULT: generated-resumes
S3_BUCKET_RESUMES=generated-resumes

# ==================== OPTIONAL: JOB SEARCH ====================
# Adzuna job search API credentials (optional).
# Get from https://developer.adzuna.com
# If not set, the app falls back to Remotive job search.
# DEFAULT: (empty string, uses fallback)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ==================== OPTIONAL: LLM CONFIGURATION ====================
# Primary LLM model for resume and email generation.
# Available Groq models: llama3-70b-8192, mixtral-8x7b-32768, gemma-7b-it
# DEFAULT: llama3-70b-8192
LLM_MODEL=llama3-70b-8192

# Fallback LLM model if primary model hits rate limit.
# DEFAULT: mixtral-8x7b-32768
LLM_FALLBACK_MODEL=mixtral-8x7b-32768

# Temperature for LLM sampling (0-1, lower=more deterministic, higher=more creative).
# DEFAULT: 0.7
LLM_TEMPERATURE=0.7

# Groq API base URL (defaults to official Groq endpoint).
# DEFAULT: https://api.groq.com/openai/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI API key for fallback LLM (optional, only used if Groq fails).
# Get from https://platform.openai.com/api-keys
# DEFAULT: (empty string, Groq is used as primary)
OPENAI_API_KEY=

# Maximum number of jobs to fetch per search query.
# DEFAULT: 20
MAX_JOBS_PER_SEARCH=20

# Minimum semantic similarity score (0-1) for job ranking.
# Jobs with scores below this threshold are filtered out.
# Range: 0.0 (accept all) to 1.0 (identical only)
# DEFAULT: 0.5
SEMANTIC_SCORE_THRESHOLD=0.5

# ==================== OPTIONAL: ENVIRONMENT & LOGGING ====================
# Application environment: 'development' or 'production'
# In production:
#   - Stricter validation (e.g., S3 endpoint must not be localhost/minio)
#   - Security settings are enforced
# DEFAULT: development
ENVIRONMENT=development

################################################################################
#                            COMPLETE EXAMPLE
#
# Below is a complete .env file with all variables filled for local development:
#
################################################################################

# DATABASE_URL=postgresql+asyncpg://rozgaar:change-me@postgres:5432/rozgaar
# REDIS_URL=redis://redis:6379/0
# SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long
# GROQ_API_KEY=gsk_your_groq_api_key_here
# API_V1_PREFIX=/api/v1
# CHROMA_HOST=http://chromadb:8000
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# RESET_PASSWORD_SECRET=reset-password-secret
# VERIFICATION_SECRET=verification-secret
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_RESUMES=generated-resumes
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# LLM_MODEL=llama3-70b-8192
# LLM_FALLBACK_MODEL=mixtral-8x7b-32768
# MAX_JOBS_PER_SEARCH=20
# SEMANTIC_SCORE_THRESHOLD=0.5
# ENVIRONMENT=development
