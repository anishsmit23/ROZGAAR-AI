# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rozgaar
# For Supabase: postgresql+asyncpg://postgres:[pw]@db.[ref].supabase.co:5432/postgres

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Upstash: redis://default:[pw]@[host].upstash.io:6379

# ─── Auth ───────────────────────────────────────────────────
SECRET_KEY=generate_with_openssl_rand_hex_32

# ─── LLM ────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here
LLM_MODEL=llama3-70b-8192
LLM_FALLBACK_MODEL=mixtral-8x7b-32768

# ─── Job Discovery ──────────────────────────────────────────
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
MAX_JOBS_PER_SEARCH=20
SEMANTIC_SCORE_THRESHOLD=0.5

# ─── Vector Store ───────────────────────────────────────────
CHROMA_HOST=http://chromadb:8000

# ─── File Storage ───────────────────────────────────────────
# Local dev (MinIO):
#S3_ENDPOINT_URL=http://minio:9000
#S3_ACCESS_KEY_ID=minioadmin
#S3_SECRET_ACCESS_KEY=minioadmin
# Production (Cloudflare R2 — replace all three):
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_BUCKET_RESUMES=generated-resumes
S3_REGION=auto

# ─── App ────────────────────────────────────────────────────
ENVIRONMENT=development